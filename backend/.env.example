# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/tibamkononi

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# CORS (comma-separated origins, or *)
CORS_ORIGINS=*

# AI (optional - falls back to built-in engine when absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
